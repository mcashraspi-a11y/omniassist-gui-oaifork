# OmniAssist configuration EXAMPLE -- copy to config/config.yml and edit.
#
#   cp config/config.yaml.example config/config.yml
#
# This file is committed, so it must never contain secrets. API keys are read
# from environment variables only; see .env.example for the list.
#
# OmniAssist speaks the OpenAI /chat/completions protocol, so any provider that
# implements it works: OpenAI, Google's OpenAI-compatible endpoint, Groq,
# Mistral, OpenRouter, Together, DeepSeek, xAI, and local servers such as
# Ollama, vLLM, LM Studio, or llama.cpp.
#
# ---------------------------------------------------------------------------
# ABOUT THE MODEL IDS BELOW
# ---------------------------------------------------------------------------
# Model IDs are provider-owned strings that change without notice, so every ID
# here was checked against a live endpoint. Two levels are marked:
#
#   [LIVE]    Called end to end with a real key: chat + tool calling confirmed.
#   [CATALOG] ID confirmed present in OpenRouter's public model catalog
#             (https://openrouter.ai/api/v1/models), but NOT called, because no
#             key was available for that provider.
#
# Nothing here is a guess. If you add a model, call it once before trusting it:
# a retired ID fails at runtime with model_not_found (404).

app:
  name: "OmniAssist"
  version: "2026.5 \"Cake\""
  description: "Operationalized Multi-Agent Networked Intelligence & Autonomous System Services Integration Toolkit"

# Default provider for model entries that do not name one.
provider: "groq"

# ---------------------------------------------------------------------------
# PROVIDERS
# ---------------------------------------------------------------------------
# Each provider is a base_url plus the name of the environment variable that
# holds its API key. Nothing secret belongs here.
#
#   base_url      OpenAI-compatible API root, ending in /v1.
#   api_key_env   Environment variable with the key. For known providers this
#                 can be omitted -- OPENAI_API_KEY, GEMINI_API_KEY, GROQ_API_KEY,
#                 and so on are found automatically.
#   api_key_optional: true  for servers that need no credential.
#
# A deployment can also override any base_url without editing this file by
# setting <PROVIDER>_BASE_URL, e.g. GROQ_BASE_URL.
providers:
  # Primary provider. Every model in its chain below is [LIVE]-verified.
  groq:
    base_url: "https://api.groq.com/openai/v1"
    api_key_env: "GROQ_API_KEY"

  # Fallback provider, with a chain of its own. [CATALOG]-verified only.
  openrouter:
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"

  # Last resort: a local server, which needs no credential at all and so is
  # always kept even when every cloud key is missing.
  ollama:
    base_url: "http://localhost:11434/v1"
    api_key_optional: true

  # Other providers, kept here for reference. OmniAssist finds their keys
  # automatically; add models for them under `models` when you have a key.
  openai:
    base_url: "https://api.openai.com/v1"
    api_key_env: "OPENAI_API_KEY"

  google:
    base_url: "https://generativelanguage.googleapis.com/v1beta/openai/"
    api_key_env: "GEMINI_API_KEY"

  mistral:
    base_url: "https://api.mistral.ai/v1"
    api_key_env: "MISTRAL_API_KEY"

  deepseek:
    base_url: "https://api.deepseek.com/v1"
    api_key_env: "DEEPSEEK_API_KEY"

  xai:
    base_url: "https://api.x.ai/v1"
    api_key_env: "XAI_API_KEY"

  together:
    base_url: "https://api.together.xyz/v1"
    api_key_env: "TOGETHER_API_KEY"

  vllm:
    base_url: "http://localhost:8000/v1"
    api_key_optional: true

  lmstudio:
    base_url: "http://localhost:1234/v1"
    api_key_optional: true

# ---------------------------------------------------------------------------
# MODELS
# ---------------------------------------------------------------------------
# The chain is tried in order until one target answers:
#
#     primary -> fallbacks[0] -> fallbacks[1] -> ...
#
# Falling through can cross providers and therefore cross API keys, so a
# missing or rate-limited provider degrades to the next one instead of failing.
#
# To give a provider its own chain, group its models together in order. The
# first group is the primary provider; the next group is the fallback provider.
# Because the walk is strictly top to bottom, this reads as:
#
#     Groq (primary)  : gpt-oss-120b -> gpt-oss-20b -> qwen3.8-27b -> safeguard
#     OpenRouter (2nd): llama-3.3-70b -> deepseek-chat
#     Ollama (last)   : llama3.1
#
# Entry forms:
#   "model-name"                                  # uses `provider` above
#   "provider/model-name"                         # shorthand
#   {provider: groq, model: "openai/gpt-oss-120b"} # longhand
#   {provider: groq, models: [a, b]}              # fan out into several targets
#
# Any entry may also override base_url, api_key_env, temperature, or max_tokens.
#
# Only entries whose provider key is present in the environment are kept;
# everything else is skipped and reported rather than attempted. So with only
# GROQ_API_KEY set, the OpenRouter and Ollama groups below are skipped and the
# Groq group carries the run. Set more keys to lengthen the chain.
models:
  # =========================================================================
  # PRIMARY PROVIDER: Groq -- its own fallback chain.
  # =========================================================================
  # [LIVE] Called with a real key: chat + tool calling both confirmed.
  # Groq has retired some older IDs (llama-3.3-70b-versatile now returns
  # model_not_found), so these are the currently valid tool-capable models.
  primary:
    provider: "groq"
    model: "openai/gpt-oss-120b"

  fallbacks:
    # --- Groq's own chain: tried in order before leaving the provider. [LIVE] ---
    - provider: "groq"
      model: "openai/gpt-oss-20b"

    - provider: "groq"
      model: "qwen/qwen3.8-27b"

    - provider: "groq"
      model: "openai/gpt-oss-safeguard-20b"

    # =======================================================================
    # FALLBACK PROVIDER: OpenRouter -- with its own fallback chain.
    # =======================================================================
    # Reached only when every Groq target above has failed. Requires
    # OPENROUTER_API_KEY; skipped and reported if that variable is unset.
    # [CATALOG] These IDs exist in OpenRouter's public catalog and were not
    # called, since no key was available. Swap in whatever you have verified.
    - provider: "openrouter"
      model: "meta-llama/llama-3.3-70b-instruct"

    - provider: "openrouter"
      model: "deepseek/deepseek-chat"

    # =======================================================================
    # LAST RESORT: a local server, no credential needed.
    # =======================================================================
    # Always kept, so the chain is never empty. Start ollama and pull the model
    # first:  ollama pull llama3.1
    - provider: "ollama"
      model: "llama3.1"

# ---------------------------------------------------------------------------
# NOTES ON MODELS THAT DO NOT WORK FOR THIS AGENT
# ---------------------------------------------------------------------------
# OmniAssist is a tool-calling agent, so a model must support the OpenAI
# `tools` parameter. These Groq models chat fine but REJECT tool calls with
# "tool calling is not supported for this model", which makes them useless here:
#
#     allam-2-7b, groq/compound, groq/compound-mini
#
# Verified as unusable rather than assumed, so they are deliberately absent.

agent:
  max_iterations: 10
  temperature: 0.2
