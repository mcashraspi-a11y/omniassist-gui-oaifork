# OmniAssist environment template.
#
# Copy to .env and fill in only the providers you intend to use. .env is
# gitignored -- never commit real keys.
#
#   cp .env.example .env
#
# Every key is optional. With none set, OmniAssist runs in offline mode against
# a deterministic stub, which is enough for the CLI, the web UI, and the tests.
#
# Provider base URLs and the model fallback chain live in config/config.yml.
# Only the secrets live here.

# ---------------------------------------------------------------------------
# Provider API keys
# ---------------------------------------------------------------------------
# The chain in config/config.yml skips any provider whose key is absent, so
# setting fewer keys simply yields a shorter chain.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Google AI Studio, via its OpenAI-compatible endpoint
# (https://aistudio.google.com/apikey). GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Mistral (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# xAI (https://console.x.ai)
XAI_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Together (https://api.together.ai/settings/api-keys)
TOGETHER_API_KEY=

# ---------------------------------------------------------------------------
# Endpoint overrides (optional)
# ---------------------------------------------------------------------------
# Any provider base_url in config/config.yml can be overridden here without
# editing the committed file -- useful for pointing at a gateway or a local
# server. Ollama, vLLM, and LM Studio need no key at all.
# OPENAI_BASE_URL=http://localhost:8000/v1
# GEMINI_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=production

# Set this to require a bearer token on the web API (strongly recommended
# whenever the web UI is reachable from anywhere but localhost).
# The agent can execute shell commands and write files.
OMNIASSIST_API_TOKEN=

# Web UI bind address (used by: python main.py --web)
OMNIASSIST_HOST=127.0.0.1
OMNIASSIST_PORT=8000
